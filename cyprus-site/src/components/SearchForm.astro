---
interface Props { value?: string; autofocus?: boolean }
const { value = '', autofocus = false } = Astro.props;
---
<form class="searchbar" action="/search/" method="get" role="search">
  <label for="q" class="visually-hidden">Поиск по сайту</label>
  <input id="q" type="search" name="q" value={value} placeholder="Компания, услуга, статья или событие" autocomplete="off" autofocus={autofocus} />
  <button class="btn" type="submit">Найти</button>
</form>
