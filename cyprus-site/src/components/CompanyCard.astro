---
import { categoriesOf, type Company } from '../lib/data';
import { getCategory } from '../data/taxonomy';
import Icon from './Icon.astro';
interface Props { company: Company }
const { company } = Astro.props;
const d = company.data;
const cat = getCategory(d.category);
---
<a class="card company" href={`/services/${company.id}/`} data-city={d.city ?? ''} data-category={categoriesOf(company).join(' ')}>
  <span class="eyebrow">{d.service_type ?? cat?.title}</span>
  <h3>{d.name}</h3>
  {d.city && <p class="loc"><Icon name="pin" size={15} />{d.city}</p>}
  {d.summary && <p class="desc" style="margin-top:6px">{d.summary}</p>}
  {d.status === 'draft' && (d.verified_at
    ? <span class="unverified pending">Проверено · на утверждении</span>
    : <span class="unverified">Не проверено</span>)}
</a>
