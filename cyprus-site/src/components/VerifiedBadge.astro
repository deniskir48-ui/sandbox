---
// Отметка Verified: автор гида лично знаком с компанией (DEC-W29). Цвет — токены --verified-*.
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
const px = size === 'lg' ? 18 : 15;
---
<span class={`verified-badge ${size}`} title="Автор гида лично знаком с компанией">
  <svg width={px} height={px} viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M12 1.8l2.5 1.8 3.1-.1 1 2.9 2.5 1.8-.9 3 .9 2.9-2.5 1.8-1 2.9-3.1-.1L12 22.2l-2.5-1.8-3.1.1-1-2.9-2.5-1.8.9-2.9-.9-3 2.5-1.8 1-2.9 3.1.1z"/>
    <path d="m8.3 12.2 2.5 2.5 4.9-5.2" fill="none" stroke="var(--verified-bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>Verified
</span>
