---
import { formatDate } from '../lib/dates';
interface Props { sources: { title: string; url: string }[]; verifiedAt?: Date }
const { sources, verifiedAt } = Astro.props;
---
{(sources.length > 0 || verifiedAt) && (
  <section class="sources" aria-label="Источники">
    <h2>Источники и проверка</h2>
    {sources.length > 0 && (
      <ul>{sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ul>
    )}
    {verifiedAt && <p>Информация проверена {formatDate(verifiedAt)}</p>}
  </section>
)}
<style>
  .sources { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.88rem; color: var(--muted); }
  .sources h2 { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .sources ul { margin: 0 0 6px; padding-left: 18px; }
  .sources p { margin: 0; }
</style>
