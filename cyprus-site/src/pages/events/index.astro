---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventCard from '../../components/EventCard.astro';
import Empty from '../../components/Empty.astro';
import { EVENT_TYPES } from '../../data/taxonomy';
import { getUpcomingEvents } from '../../lib/data';

const events = await getUpcomingEvents();
const cities = [...new Set(events.map((e) => e.data.city))].sort((a, b) => a.localeCompare(b, 'ru'));
const types = [...new Set(events.map((e) => e.data.type))];
---
<Base title="Афиша Кипра: ближайшие мероприятия" description="Предстоящие концерты, спектакли, фестивали и другие события на Кипре с датами, местами и ссылками на официальные источники и билеты.">
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { label: 'Афиша' }]} />
  <h1>Афиша</h1>
  <p class="lead">Ближайшие мероприятия на Кипре. Билеты мы не продаём — ведём на официальные страницы организаторов и билетных площадок.</p>

  {events.length > 0 ? (
    <>
      <form class="filters" id="filters" aria-label="Фильтры афиши">
        <label>Когда
          <select name="when">
            <option value="">Все даты</option>
            <option value="today">Сегодня</option>
            <option value="weekend">Ближайшие выходные</option>
            <option value="week">7 дней</option>
            <option value="month">30 дней</option>
          </select>
        </label>
        <label>Город
          <select name="city">
            <option value="">Все</option>
            {cities.map((c) => <option value={c}>{c}</option>)}
          </select>
        </label>
        <label>Порядок
          <select name="sort">
            <option value="">По важности</option>
            <option value="date">По дате</option>
          </select>
        </label>
        <label>Тип
          <select name="type">
            <option value="">Все</option>
            {types.map((t) => <option value={t}>{EVENT_TYPES[t]}</option>)}
          </select>
        </label>
      </form>
      <p class="small muted" id="count" aria-live="polite">Найдено: {events.length}</p>
      <ul class="grid grid-2" id="list">{events.map((e) => <li><EventCard event={e} /></li>)}</ul>
      <div id="no-results" hidden><Empty title="Нет мероприятий по этим условиям">Измените дату, город или тип события.</Empty></div>
    </>
  ) : (
    <Empty title="Афиша готовится">Мероприятия появятся после проверки дат, мест и ссылок на билеты по официальным источникам.</Empty>
  )}
</Base>

<script>
  import { bindFilters, todayCyprus } from '../../lib/filters';

  // Диапазон для фильтра «Когда».
  function range(when: string): [string, string] | null {
    const today = todayCyprus();
    if (when === 'today') return [today, today];
    if (when === 'week') return [today, todayCyprus(6)];
    if (when === 'month') return [today, todayCyprus(29)];
    if (when === 'weekend') {
      const wd = new Date(today + 'T12:00:00Z').getUTCDay(); // 0 — вс, 6 — сб
      const toSat = wd === 0 ? -1 : 6 - wd;
      return [todayCyprus(Math.max(toSat, 0)), todayCyprus(wd === 0 ? 0 : toSat + 1)];
    }
    return null;
  }

  // Порядок: по умолчанию как собрано (приоритет → дата), «По дате» — хронологически.
  const listEl = document.querySelector('#list');
  const original = listEl ? [...listEl.children] as HTMLElement[] : [];
  const sortSel = document.querySelector<HTMLSelectElement>('select[name=sort]');
  function reorder() {
    if (!listEl) return;
    const key = (li: HTMLElement) => (li.firstElementChild as HTMLElement).dataset.key ?? '';
    const items = sortSel?.value === 'date' ? [...original].sort((a, b) => key(a).localeCompare(key(b))) : original;
    listEl.append(...items);
  }
  sortSel?.addEventListener('change', reorder);

  bindFilters({
    form: '#filters', items: '#list > li', count: '#count', empty: '#no-results',
    match: (li, f) => {
      const card = li.firstElementChild as HTMLElement;
      const { start = '', end = '', city, type } = card.dataset;
      if (end < todayCyprus()) return false; // страница собрана раньше, а событие уже прошло
      if (f.city && city !== f.city) return false;
      if (f.type && type !== f.type) return false;
      const r = range(f.when);
      if (r && (start > r[1] || end < r[0])) return false;
      return true;
    },
  });
  reorder(); // после восстановления фильтров из URL
</script>
