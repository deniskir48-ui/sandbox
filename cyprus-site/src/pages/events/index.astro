---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventCard from '../../components/EventCard.astro';
import Empty from '../../components/Empty.astro';
import ChipGroup from '../../components/ChipGroup.astro';
import { EVENT_TYPES } from '../../data/taxonomy';
import { getUpcomingEvents } from '../../lib/data';
import { regionOptions } from '../../data/regions';

const events = await getUpcomingEvents();
// Варианты фильтров — по числу событий: сначала крупные районы и частые типы, «Другое» в конце.
// Деревни в фильтр не выводятся: они сведены к районам (src/data/regions.json).
const countBy = <T extends string>(xs: T[]) => xs.reduce((m, x) => m.set(x, (m.get(x) ?? 0) + 1), new Map<T, number>());
const regions = regionOptions(events.map((e) => e.data.city));
const typeCount = countBy(events.map((e) => e.data.type));
const types = [...typeCount.keys()].sort((a, b) => Number(a === 'other') - Number(b === 'other') || typeCount.get(b)! - typeCount.get(a)!);
---
<Base title="Афиша Кипра: ближайшие мероприятия" description="Предстоящие концерты, спектакли, фестивали и другие события на Кипре с датами, местами и ссылками на официальные источники и билеты.">
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { label: 'Афиша' }]} />
  <div class="page-head">
    <h1>Афиша</h1>
    <p class="lead">Ближайшие мероприятия на Кипре. Сначала главное, потом всё остальное. Билеты мы не продаём, а ведём на официальные страницы организаторов и площадок.</p>
  </div>

  {events.length > 0 ? (
    <>
      <form class="filters" id="filters" aria-label="Фильтры афиши">
        <ChipGroup legend="Когда" name="when" options={[
          { value: '', label: 'Все даты' }, { value: 'today', label: 'Сегодня' }, { value: 'weekend', label: 'Выходные' },
          { value: 'week', label: '7 дней' }, { value: 'month', label: '30 дней' },
        ]} />
        <ChipGroup legend="Тип" name="type" options={[{ value: '', label: 'Все' }, ...types.map((t) => ({ value: t, label: EVENT_TYPES[t] }))]} />
        <ChipGroup legend="Где" name="city" options={[{ value: '', label: 'Везде' }, ...regions.map((r) => ({ value: r, label: r }))]} />
      </form>
      <div class="list-bar">
        <p class="result-count" id="count" aria-live="polite">Найдено: {events.length}</p>
        <ChipGroup legend="Порядок" name="sort" form="filters" compact hideLegend options={[{ value: '', label: 'Сначала главное' }, { value: 'date', label: 'По дате' }]} />
      </div>
      <ul class="grid grid-3" id="list">{events.map((e) => <li><EventCard event={e} /></li>)}</ul>
      <div id="no-results" hidden><Empty title="Нет мероприятий по этим условиям">Измените дату, место или тип события.</Empty></div>
    </>
  ) : (
    <Empty title="Афиша готовится">Мероприятия появятся после проверки дат, мест и ссылок на билеты по официальным источникам.</Empty>
  )}
</Base>

<script>
  import { bindFilters, todayCyprus } from '../../lib/filters';
  import { UNKNOWN_REGION } from '../../data/regions';

  // Диапазон для фильтра «Когда».
  function range(when: string): [string, string] | null {
    const today = todayCyprus();
    if (when === 'today') return [today, today];
    if (when === 'week') return [today, todayCyprus(6)];
    if (when === 'month') return [today, todayCyprus(29)];
    if (when === 'weekend') {
      const wd = new Date(today + 'T12:00:00Z').getUTCDay(); // 0 — вс, 6 — сб
      const toSat = wd === 0 ? -1 : 6 - wd;
      return [todayCyprus(Math.max(toSat, 0)), todayCyprus(wd === 0 ? 0 : toSat + 1)];
    }
    return null;
  }

  // Порядок: по умолчанию как собрано (приоритет → дата), «По дате» — хронологически.
  const listEl = document.querySelector('#list');
  const original = listEl ? [...listEl.children] as HTMLElement[] : [];
  const sortValue = () => document.querySelector<HTMLInputElement>('input[name=sort]:checked')?.value ?? '';
  function reorder() {
    if (!listEl) return;
    const key = (li: HTMLElement) => (li.firstElementChild as HTMLElement).dataset.key ?? '';
    const items = sortValue() === 'date' ? [...original].sort((a, b) => key(a).localeCompare(key(b))) : original;
    listEl.append(...items);
  }
  document.querySelectorAll('input[name=sort]').forEach((el) => el.addEventListener('change', reorder));

  bindFilters({
    form: '#filters', items: '#list > li', count: '#count', empty: '#no-results',
    match: (li, f) => {
      const card = li.firstElementChild as HTMLElement;
      const { start = '', end = '', city, type } = card.dataset;
      if (end < todayCyprus()) return false; // страница собрана раньше, а событие уже прошло
      if (f.city && !(city ?? '').split('|').some((r) => r === f.city || (r === '*' && f.city !== UNKNOWN_REGION))) return false;
      if (f.type && type !== f.type) return false;
      const r = range(f.when);
      if (r && (start > r[1] || end < r[0])) return false;
      return true;
    },
  });
  reorder(); // после восстановления фильтров из URL
</script>
