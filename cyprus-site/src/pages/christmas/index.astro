---
// Сезонный лендинг «Рождество на Кипре»: парки и праздники недели. Данные — события Афиши с метками christmas-*
// (импорт: scripts/import-christmas.py из таблицы «Афиша Кипра для Telegram»).
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import { getUpcomingEvents, eventLastDay } from '../../lib/data';
import { formatDay } from '../../lib/dates';

const all = (await getUpcomingEvents()).filter((e) => e.data.tags.includes('christmas'));
const byDate = (a: (typeof all)[number], b: (typeof all)[number]) =>
  `${a.data.date}T${a.data.time ?? '00:00'}`.localeCompare(`${b.data.date}T${b.data.time ?? '00:00'}`);
const parks = all.filter((e) => e.data.tags.includes('christmas-parks')).sort(byDate);
const week = all.filter((e) => !e.data.tags.includes('christmas-parks')).sort(byDate);

const KINDS = [
  { tag: 'christmas-villages', label: 'Рождественские деревни' },
  { tag: 'christmas-lights', label: 'Ёлки и огни' },
  { tag: 'christmas-markets', label: 'Ярмарки' },
  { tag: 'christmas-other', label: 'Мастер-классы и другое' },
];
const kindOf = (e: (typeof all)[number]) => KINDS.find((k) => e.data.tags.includes(k.tag))?.tag ?? 'christmas-other';
const kinds = KINDS.map((k) => ({ ...k, n: week.filter((e) => kindOf(e) === k.tag).length })).filter((k) => k.n > 0);
const short = (iso: string) => formatDay(iso, false).replace(/ \d{4}$/, '');
const openTime = (h?: string) => h?.match(/\d{1,2}:\d{2}/)?.[0] ?? '';
const mapUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---
<Base title="Рождество на Кипре 2026: парки, ёлки и ярмарки" description="Рождественские парки Кипра сезона 2026–2027 и праздники недели: зажжение ёлок, рождественские деревни, ярмарки и мастер-классы.">
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { label: 'Рождество на Кипре' }]} />

  <section class="xmas-hero">
    <svg class="garland" viewBox="0 0 800 46" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 6 Q100 38 200 12 T400 12 T600 12 T800 6" fill="none" stroke="#2c3b5c" stroke-width="2"/>
      {[[40,17,'#ffd38a'],[95,26,'#9fd5f2'],[150,24,'#f26b21'],[205,13,'#ffd38a'],[260,19,'#7ee2b8'],[315,26,'#9fd5f2'],[365,19,'#f26b21'],[415,13,'#ffd38a'],[470,20,'#9fd5f2'],[520,26,'#7ee2b8'],[570,19,'#f26b21'],[620,13,'#ffd38a'],[675,20,'#9fd5f2'],[725,25,'#f26b21'],[775,13,'#ffd38a']].map(([x, y, c]) => (
        <circle class="bulb" cx={x} cy={y} r="4.5" fill={c as string} />
      ))}
    </svg>
    <p class="kicker">Сезон 2026–2027</p>
    <h1>Рождество на&nbsp;Кипре</h1>
    <p class="lead">Хэллоуинские тыквы ещё не везде убрали, а Санта-Клаусы уже готовятся к выходу на работу. Здесь все рождественские парки острова и праздники ближайших дней: ёлки, деревни, ярмарки.</p>
    <p class="counts"><span><strong>{parks.length}</strong> парка</span><span><strong>{week.length}</strong> праздников на неделе</span></p>
  </section>

  {parks.length > 0 && (
    <section aria-labelledby="parks-h">
      <div class="section-head"><h2 id="parks-h">Рождественские парки</h2></div>
      <ul class="parks">
        {parks.map((e) => {
          const d = e.data;
          return (
            <li class="park" data-start={d.date} data-end={eventLastDay(e)} data-time={openTime(d.hours)}>
              <div class="park-top">
                <span class="park-place">{d.city}{d.venue ? ` · ${d.venue}` : ''}</span>
                <span class="park-status"></span>
              </div>
              <h3><a href={`/events/${e.id}/`}>{d.title}</a></h3>
              <p class="park-when">{short(d.date)} — {short(eventLastDay(e))}</p>
              {d.summary && <p class="park-desc">{d.summary}</p>}
              <dl class="park-facts">
                {d.hours && <div><dt>Часы</dt><dd>{d.hours}</dd></div>}
                {d.price && <div><dt>Стоимость</dt><dd>{d.price}</dd></div>}
              </dl>
              <div class="park-links">
                {d.ticket_url && <a href={d.ticket_url} target="_blank" rel="noopener">Источник <Icon name="external" size={14} /></a>}
                <a href={mapUrl(`${d.venue ?? d.title} ${d.city}`)} target="_blank" rel="noopener">На карте <Icon name="pin" size={14} /></a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {week.length > 0 && (
    <section aria-labelledby="week-h">
      <div class="section-head"><h2 id="week-h">Праздники ближайших дней</h2><a href="/events/">Вся афиша</a></div>
      <div class="xmas-chips" role="group" aria-label="Что показать">
        <button type="button" class="xchip" id="k-all" data-kind="" aria-pressed="true">Все <em>{week.length}</em></button>
        {kinds.map((k) => <button type="button" class="xchip" id={`k-${k.tag}`} data-kind={k.tag} aria-pressed="false">{k.label} <em>{k.n}</em></button>)}
      </div>
      <ul class="grid grid-3" id="xmas-list">
        {week.map((e) => <li data-kind={kindOf(e)} data-end={eventLastDay(e)}><EventCard event={e} /></li>)}
      </ul>
    </section>
  )}

  <p class="xmas-note">Подборка обновляется каждую неделю. Время, цены и программа могут меняться — перед поездкой проверяйте по ссылке на источник.</p>
</Base>

<style>
  .xmas-hero {
    position: relative; overflow: hidden; margin: 4px 0 8px; padding: 46px 22px 26px; border-radius: var(--radius);
    background: radial-gradient(120% 80% at 80% 0%, #1b2c4f 0%, #0b1324 60%, #080d19 100%); color: #eef3f9;
  }
  .garland { position: absolute; inset: 0 0 auto; width: 100%; height: 46px; }
  .bulb { animation: twinkle 3.2s ease-in-out infinite; }
  .bulb:nth-child(3n) { animation-delay: .8s; } .bulb:nth-child(3n+1) { animation-delay: 1.7s; }
  @keyframes twinkle { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .bulb { animation: none; } }
  .kicker { margin: 0; font-size: .76rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #9fd5f2; }
  .xmas-hero h1 { margin: 8px 0 12px; color: #fff; }
  .xmas-hero .lead { margin: 0; color: #b9c6d8; max-width: 62ch; }
  .counts { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 16px 0 0; color: #b9c6d8; font-size: .92rem; }
  .counts strong { color: #ffd38a; font-variant-numeric: tabular-nums; }

  .parks { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .park { display: flex; flex-direction: column; gap: 8px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); }
  .park-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .park-place { font-size: .74rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .park-status { font-size: .76rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-ink); }
  .park-status:empty { display: none; }
  .park-status.now { background: var(--verified-bg); color: var(--verified-text); }
  .park h3 { margin: 0; font-size: 1.15rem; }
  .park h3 a { color: inherit; text-decoration: none; }
  .park h3 a:hover { color: var(--accent-ink); }
  .park-when { margin: 0; font-weight: 650; font-variant-numeric: tabular-nums; }
  .park-desc { margin: 0; color: var(--muted); }
  .park-facts { margin: 0; display: grid; gap: 4px; font-size: .9rem; }
  .park-facts div { display: grid; grid-template-columns: 88px 1fr; gap: 8px; }
  .park-facts dt { color: var(--muted); }
  .park-facts dd { margin: 0; }
  .park-links { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 8px 16px; font-weight: 600; font-size: .92rem; }
  .park-links a { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; }

  .xmas-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
  .xchip { font: 600 .9rem inherit; font-family: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 7px 13px; cursor: pointer; }
  .xchip em { font-style: normal; color: var(--muted); font-weight: 500; margin-left: 2px; }
  .xchip[aria-pressed="true"] { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-text); }
  .xchip[aria-pressed="true"] em { color: inherit; opacity: .75; }
  .xchip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .xmas-note { margin: 28px 0 0; font-size: .88rem; color: var(--muted); max-width: 70ch; }
</style>

<script>
  import { todayCyprus } from '../../lib/filters';
  const today = todayCyprus();
  const MONTHS = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
  const DAYS = ['в воскресенье', 'в понедельник', 'во вторник', 'в среду', 'в четверг', 'в пятницу', 'в субботу'];
  const d = (iso: string) => new Date(iso + 'T12:00:00Z');
  const human = (iso: string) => `${d(iso).getUTCDate()} ${MONTHS[d(iso).getUTCMonth()]}`;

  // Статус парка по дате на Кипре; работающие — первыми, прошедшие скрываются.
  const parks = [...document.querySelectorAll<HTMLElement>('.park')];
  parks.forEach((li) => {
    const { start = '', end = '', time } = li.dataset;
    const el = li.querySelector<HTMLElement>('.park-status')!;
    if (end < today) { li.hidden = true; return; }
    if (start > today) {
      const n = Math.round((d(start).getTime() - d(today).getTime()) / 86400000);
      el.textContent = n === 1 ? `Откроется завтра${time ? ` в ${time}` : ''}` : n < 7 ? `Откроется ${DAYS[d(start).getUTCDay()]}` : `Откроется ${human(start)}`;
      li.dataset.rank = '1';
    } else {
      el.textContent = end === today ? 'Сегодня последний день' : `Работает до ${human(end)}`;
      el.classList.add('now');
      li.dataset.rank = '0';
    }
  });
  const pl = document.querySelector('.parks');
  parks.sort((a, b) => Number(a.dataset.rank ?? 2) - Number(b.dataset.rank ?? 2)).forEach((li) => pl?.appendChild(li));

  // Праздники недели: прошедшие скрыты, фильтр по виду.
  const items = [...document.querySelectorAll<HTMLElement>('#xmas-list > li')];
  items.forEach((li) => { if ((li.dataset.end ?? '') < today) li.remove(); });
  const live = [...document.querySelectorAll<HTMLElement>('#xmas-list > li')];
  const chips = document.querySelectorAll<HTMLButtonElement>('.xchip');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    live.forEach((li) => { li.hidden = !!c.dataset.kind && li.dataset.kind !== c.dataset.kind; });
  }));
</script>
