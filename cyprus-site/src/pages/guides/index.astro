---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Empty from '../../components/Empty.astro';
import { getPublishedArticles } from '../../lib/data';
const articles = await getPublishedArticles();
---
<Base title="Практические статьи о жизни на Кипре" description="Пошаговые материалы о покупке автомобиля, недвижимости, выборе школы, изучении греческого и других задачах на Кипре.">
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { label: 'Статьи' }]} />
  <h1>Статьи</h1>
  <p class="lead">Практические материалы: как решить конкретную задачу на Кипре и к кому обратиться.</p>
  {articles.length > 0 ? (
    <ul class="grid grid-2">{articles.map((a) => <li><ArticleCard article={a} /></li>)}</ul>
  ) : (
    <Empty title="Первые статьи в работе">Публикуем только материалы с проверенными фактами и ссылками на источники.</Empty>
  )}
</Base>
