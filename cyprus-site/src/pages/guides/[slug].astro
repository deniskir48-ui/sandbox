---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import SourceList from '../../components/SourceList.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getSection } from '../../data/taxonomy';
import { getPublishedArticles, getCompanyMap, type Article } from '../../lib/data';
import { formatDate, isoDate } from '../../lib/dates';
import { SITE } from '../../config';

export async function getStaticPaths() {
  return (await getPublishedArticles()).map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
const d = article.data;
const { Content } = await render(article);
const section = d.section ? getSection(d.section) : undefined;
const minutes = Math.max(1, Math.round((article.body ?? '').split(/\s+/).filter(Boolean).length / 180));
const others = (await getPublishedArticles()).filter((a) => a.id !== article.id).slice(0, 3);
const map = await getCompanyMap();
// Показываем только опубликованные компании; ссылки на черновики отбрасываются (их ловит check:data).
const companies = d.companies.map((s) => map.get(s)).filter((c) => c !== undefined);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
  datePublished: isoDate(d.published_at), ...(d.updated_at && { dateModified: isoDate(d.updated_at) }),
  inLanguage: 'ru', publisher: { '@type': 'Organization', name: SITE.name },
};
---
<Base title={d.title} description={d.description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { href: '/guides/', label: 'Статьи' }, { label: d.title }]} />
  <article class="article">
    <header class="art-head">
      <p class="eyebrow">{section?.title ?? 'О Кипре'}</p>
      <h1>{d.title}</h1>
      <p class="meta">
        <span>Опубликовано <time datetime={isoDate(d.published_at)}>{formatDate(d.published_at)}</time></span>
        {d.updated_at && <span>Обновлено <time datetime={isoDate(d.updated_at)}>{formatDate(d.updated_at)}</time></span>}
        <span>{minutes} мин чтения</span>
      </p>
    </header>
    <div class="prose"><Content /></div>
    {companies.length > 0 && (
      <section class="art-companies">
        <h2>Компании из гида</h2>
        <ul class="grid grid-2">{companies.map((c) => <li><CompanyCard company={c} /></li>)}</ul>
      </section>
    )}
    <div class="prose"><SourceList sources={d.sources} /></div>
  </article>

  {others.length > 0 && (
    <>
      <div class="section-head"><h2>Ещё статьи</h2><a href="/guides/">Все статьи</a></div>
      <ul class="grid grid-3">{others.map((a) => <li><ArticleCard article={a} /></li>)}</ul>
    </>
  )}
</Base>
<style>
  .article { max-width: 42rem; margin: 0 auto; }
  .art-head { margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .art-head h1 { margin-top: 8px; }
  .art-companies { margin-top: 28px; }
  .art-companies h2 { margin-bottom: 12px; }
</style>
