---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchForm from '../../components/SearchForm.astro';
---
<Base title="Поиск по сайту" description="Поиск по компаниям гида, мероприятиям афиши и статьям." noindex>
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { label: 'Поиск' }]} />
  <h1>Поиск</h1>
  <SearchForm autofocus />
  <p class="result-count" id="status" aria-live="polite" style="margin-top:14px"></p>
  <ul class="grid grid-2" id="results" style="margin-top:8px"></ul>
  <noscript><p class="notice">Для поиска нужен JavaScript. Разделы доступны через меню: Гид, Афиша, Статьи.</p></noscript>
</Base>

<script>
  import { todayCyprus } from '../../lib/filters';
  type Item = { kind: string; url: string; title: string; meta: string; text: string; end?: string };
  const KIND: Record<string, string> = { company: 'Гид', event: 'Афиша', article: 'Статья' };

  const norm = (s: string) => s.toLowerCase().replace(/ё/g, 'е').normalize('NFKD').replace(/[̀-ͯ]/g, '');

  // Простая работа с формами русских слов: «лодка» находит «лодок», «баня» — «бани», «школа» — «школы».
  const ENDINGS = ['иями', 'ями', 'ами', 'ого', 'его', 'ому', 'ему', 'ыми', 'ими', 'ией', 'ых', 'их', 'ой', 'ей', 'ий', 'ый', 'ая', 'яя', 'ое', 'ее', 'ые', 'ие', 'ую', 'юю', 'ов', 'ев', 'ам', 'ям', 'ах', 'ях', 'ом', 'ем', 'ию', 'ия', 'ии', 'а', 'я', 'ы', 'и', 'у', 'ю', 'е', 'о', 'ь', 'й'];
  const stem = (w: string) => {
    for (const e of ENDINGS) if (w.endsWith(e) && w.length - e.length >= 3) return w.slice(0, -e.length);
    return w;
  };
  const C = '[бвгджзйклмнпрстфхцчшщ]';
  // Беглая гласная: «лодк» ↔ «лодок», «ложк» ↔ «ложек».
  const variants = (st: string) => {
    const out = [st];
    const ins = st.match(new RegExp(`^(.*${C})(${C})$`));
    if (ins) out.push(`${ins[1]}о${ins[2]}`, `${ins[1]}е${ins[2]}`);
    const del = st.match(new RegExp(`^(.*${C})[ое](${C})$`));
    if (del && del[1].length >= 2) out.push(del[1] + del[2]);
    return out;
  };
  const words = (s: string) => s.split(/[^a-zа-я0-9]+/).filter(Boolean);
  // Совпадение ищется с начала слова: «тату» не находит «статус», но «лимас» находит «Лимассол».
  function matches(term: string, hayWords: string[]) {
    const vs = variants(stem(term));
    return hayWords.some((w) => {
      if (w.startsWith(term)) return true;
      const ws = stem(w);
      return vs.some((v) => ws === v || (v.length >= 4 && w.startsWith(v)));
    });
  }
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const status = document.querySelector<HTMLElement>('#status')!;
  const list = document.querySelector<HTMLUListElement>('#results')!;
  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  input.value = q;

  async function run() {
    if (!q) { status.textContent = 'Введите запрос: название компании, услугу, город или тему.'; return; }
    status.textContent = 'Ищем…';
    let items: Item[] = [];
    try { items = await (await fetch('/search-index.json')).json(); } catch { status.textContent = 'Не удалось загрузить поиск. Обновите страницу.'; return; }
    const today = todayCyprus();
    const terms = words(norm(q));
    const scored = items
      .filter((i) => !i.end || i.end >= today)
      .map((i) => {
        const title = norm(i.title), hay = norm(`${i.title} ${i.meta} ${i.text}`);
        const hayWords = words(hay), titleWords = words(title);
        if (!terms.every((t) => matches(t, hayWords))) return null;
        return { i, score: terms.filter((t) => matches(t, titleWords)).length };
      })
      .filter((x) => x !== null)
      .sort((a, b) => b.score - a.score);
    status.textContent = scored.length ? `Найдено: ${scored.length}` : `По запросу «${q}» ничего не найдено. Попробуйте другое слово или откройте разделы Гида.`;
    list.innerHTML = scored.map(({ i }) => `
      <li><a class="card" href="${esc(i.url)}">
        <div class="meta"><span class="chip">${KIND[i.kind] ?? ''}</span><span>${esc(i.meta)}</span></div>
        <h3 style="margin-top:6px">${esc(i.title)}</h3>
        ${i.text ? `<p class="small muted">${esc(i.text.slice(0, 160))}</p>` : ''}
      </a></li>`).join('');
  }
  run();
</script>
