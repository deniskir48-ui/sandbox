---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import Empty from '../../components/Empty.astro';
import { SECTIONS, type Section } from '../../data/taxonomy';
import { getPublishedCompanies } from '../../lib/data';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section: section.slug }, props: { section } }));
}
const { section } = Astro.props as { section: Section };
const companies = (await getPublishedCompanies()).filter((c) => c.data.section === section.slug);
const cities = [...new Set(companies.map((c) => c.data.city).filter(Boolean))].sort((a, b) => a!.localeCompare(b!, 'ru'));
const usedCats = section.categories.filter((cat) => companies.some((c) => c.data.category === cat.slug));
---
<Base
  title={`${section.title} на Кипре`}
  description={`${section.title}: ${section.intro}`}
  noindex={companies.length === 0}
>
  <Breadcrumbs items={[{ href: '/', label: 'Главная' }, { href: '/catalog/', label: 'Гид' }, { label: section.title }]} />
  <header class="sec-head">
    <span class="sec-icon"><Icon name={section.slug} size={28} /></span>
    <div>
      <h1>{section.title}</h1>
      <p class="lead">{section.intro}</p>
    </div>
  </header>

  {companies.length > 0 ? (
    <>
      {(cities.length > 1 || usedCats.length > 1) && (
        <form class="filters" id="filters" aria-label="Фильтры">
          {usedCats.length > 1 && (
            <label>Категория
              <select name="category">
                <option value="">Все</option>
                {usedCats.map((c) => <option value={c.slug}>{c.title}</option>)}
              </select>
            </label>
          )}
          {cities.length > 1 && (
            <label>Город
              <select name="city">
                <option value="">Все</option>
                {cities.map((c) => <option value={c}>{c}</option>)}
              </select>
            </label>
          )}
        </form>
      )}
      <p class="result-count" id="count" aria-live="polite">Найдено: {companies.length}</p>
      <ul class="grid grid-3" id="list">{companies.map((c) => <li><CompanyCard company={c} /></li>)}</ul>
      <div id="no-results" hidden><Empty title="Ничего не найдено">Попробуйте сбросить фильтры.</Empty></div>
    </>
  ) : (
    <Empty title="Раздел наполняется">
      Мы проверяем компании этого раздела: официальный сайт, услуги, город и дату актуальности. Карточки появятся после проверки.
    </Empty>
  )}
  <p class="cta-add">Нет вашей компании в разделе «{section.title}»? <a href={`/add-company/?section=${section.slug}`}>Предложите её для гида</a></p>
</Base>

<script>
  import { bindFilters } from '../../lib/filters';
  bindFilters({ form: '#filters', items: '#list > li', count: '#count', empty: '#no-results',
    match: (el, f) => {
      const card = el.firstElementChild as HTMLElement;
      return (!f.category || card.dataset.category === f.category) && (!f.city || card.dataset.city === f.city);
    } });
</script>
<style>
  .sec-head { display: flex; gap: 16px; align-items: flex-start; margin: 4px 0 20px; }
  .sec-head .lead { margin-bottom: 0; }
  .sec-icon { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-ink); margin-top: 2px; }
  @media (max-width: 520px) { .sec-icon { width: 46px; height: 46px; border-radius: 13px; } }
</style>
