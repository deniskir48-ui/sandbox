{
  "name": "cyprus-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "dev:fixtures": "USE_FIXTURES=1 astro dev",
    "build": "npm run check:data && astro build",
    "build:fixtures": "USE_FIXTURES=1 astro build --outDir dist-fixtures",
    "preview": "astro preview",
    "check:data": "node scripts/check-data.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "build:preview": "PREVIEW_DRAFTS=1 astro build --outDir dist-preview",
    "dev:preview": "PREVIEW_DRAFTS=1 astro dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
