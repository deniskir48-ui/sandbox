# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Claude (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Стоковое видео: достаточно ОДНОГО из двух ключей (оба бесплатные)
# Pixabay: https://pixabay.com/api/docs/ (ключ виден в разделе Parameters после входа)
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# Необязательно: голоса ElevenLabs
ELEVENLABS_API_KEY=

# YouTube: OAuth-клиент типа "Desktop app" из Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Instagram (профессиональный аккаунт): долгоживущий токен и ID пользователя
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok for Developers: приложение с Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=secrets/tiktok_token.json
